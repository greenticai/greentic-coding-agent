repo-index = {
  version: text,
  ? repo_id: text,
  repo_name: text,
  repo_role: repo-role,
  generated_at: text,
  ? metadata: repo-index-metadata,
  freshness: freshness-status,
  manifest: repo-agent-manifest,
  concept_graph: [* concept-descriptor],
  workflow_graph: [* workflow-descriptor],
  validations: [* validation-descriptor],
  reuse: [* reuse-descriptor],
  ? training_courses: [* training-course-descriptor],
  ? knowledge_updates: [* knowledge-update-descriptor],
  instruction_graph: [* instruction-descriptor],
  instruction_paths: [* text],
  source_stats: source-stats,
}

repo-index-metadata = {
  repo_id: text,
  ? branch: text,
  ? commit_sha: text,
  ? commit_time: text,
  indexed_at: text,
  index_schema_version: text,
  tool_version: text,
  ? source_tree_hash: text,
}

repo-agent-manifest = {
  version: text,
  ? repo_id: text,
  repo_name: text,
  ? org: text,
  repo_root: text,
  repo_role: repo-role,
  primary_language: text,
  generated_at: text,
  candidate_docs: [* text],
  cargo_manifests: [* text],
}

concept-descriptor = {
  id: text,
  title: text,
  summary: text,
  scope: knowledge-scope,
  lifecycle_phase: lifecycle-phase,
  owners: [* text],
  related_paths: [* text],
}

workflow-descriptor = {
  id: text,
  title: text,
  summary: text,
  phase: lifecycle-phase,
  commands: [* text],
  docs: [* text],
  concept_ids: [* text],
}

instruction-descriptor = {
  id: text,
  path: text,
  title: text,
  kind: text,
  headings: [* text],
  commands: [* text],
  concept_ids: [* text],
}

validation-descriptor = {
  id: text,
  title: text,
  summary: text,
  phase: lifecycle-phase,
  command_groups: [* text],
  triggered_by: [* text],
}

reuse-descriptor = {
  id: text,
  concept_id: text,
  owner_repo: text,
  rationale: text,
  forbidden_locations: [* text],
  required_validations: [* text],
}

training-course-descriptor = {
  version: text,
  id: text,
  title: text,
  summary: text,
  owner_repo: text,
  teaches_concepts: [* text],
  tasks: [* text],
  audience: [* training-audience],
  lifecycle_phase: lifecycle-phase,
  modules: [* training-module-descriptor],
  canonical_commands: [* text],
  deprecated_commands: [* deprecated-command-descriptor],
  required_validations: [* text],
  examples: [* text],
  source_paths: [* text],
}

training-module-descriptor = {
  id: text,
  title: text,
  objective: text,
  steps: [* training-step-descriptor],
}

training-step-descriptor = {
  order: uint,
  instruction: text,
  ? command: text,
  ? expected_output: text,
  ? validation: text,
}

deprecated-command-descriptor = {
  command: text,
  reason: text,
  ? replacement: text,
}

knowledge-update-descriptor = {
  version: text,
  id: text,
  title: text,
  summary: text,
  owner_repo: text,
  update_type: knowledge-update-type,
  published_at: text,
  ? effective_from: text,
  ? expires_at: text,
  affected_concepts: [* text],
  affected_workflows: [* text],
  affected_courses: [* text],
  affected_repos: [* text],
  agent_instruction: text,
  ? human_summary: text,
  new_capabilities: [* capability-announcement],
  deprecated_commands: [* deprecated-command-descriptor],
  replaced_guidance: [* replaced-guidance-descriptor],
  migration_steps: [* migration-step-descriptor],
  required_validations: [* text],
  source_paths: [* text],
  severity: knowledge-update-severity,
}

capability-announcement = {
  id: text,
  title: text,
  summary: text,
  use_when: [* text],
  owner_repo: text,
  ? related_course: text,
}

replaced-guidance-descriptor = {
  old_guidance: text,
  replacement_guidance: text,
  reason: text,
}

migration-step-descriptor = {
  order: uint,
  instruction: text,
  ? command: text,
  ? validation: text,
}

source-stats = {
  workspace_members: [* text],
  crate_names: [* text],
  modules: [* text],
  public_items: [* text],
  ? rust_symbols: [* rust-symbol-descriptor],
  test_targets: [* text],
  feature_names: [* text],
  dependencies: [* text],
  markdown_docs: [* text],
  workflow_files: [* text],
  example_paths: [* text],
}

rust-symbol-descriptor = {
  name: text,
  kind: rust-symbol-kind,
  visibility: text,
  path: text,
  ? line: uint,
}

rust-symbol-kind = &(
  function: "function",
  struct: "struct",
  enum: "enum",
  trait: "trait",
  impl: "impl",
  module: "module",
  use: "use",
  test: "test",
)

repo-role = &(
  core_contracts: "core_contracts",
  cli_launcher: "cli_launcher",
  component_authoring: "component_authoring",
  flow_authoring: "flow_authoring",
  pack_authoring: "pack_authoring",
  bundle_assembly: "bundle_assembly",
  solution_layer: "solution_layer",
  sorla_layer: "sorla_layer",
  provider_family: "provider_family",
  demo_app: "demo_app",
  customer_solution: "customer_solution",
  examples_only: "examples_only",
)

knowledge-scope = &(
  local_repo: "local_repo",
  workspace: "workspace",
  cross_repo: "cross_repo",
  published_catalog: "published_catalog",
)

lifecycle-phase = &(
  design: "design",
  build: "build",
  setup: "setup",
  start: "start",
  runtime: "runtime",
  update: "update",
  remove: "remove",
)

freshness-status = &(
  fresh: "fresh",
  stale: "stale",
  unknown: "unknown",
)

training-audience = &(
  coding_agent: "coding_agent",
  human_developer: "human_developer",
  ci_automation: "ci_automation",
  repo_maintainer: "repo_maintainer",
)

knowledge-update-type = &(
  new_capability: "new_capability",
  behaviour_change: "behaviour_change",
  deprecated_workflow: "deprecated_workflow",
  deprecated_command: "deprecated_command",
  migration_required: "migration_required",
  validation_changed: "validation_changed",
  ownership_changed: "ownership_changed",
  course_updated: "course_updated",
  security_notice: "security_notice",
  breaking_change: "breaking_change",
  documentation_correction: "documentation_correction",
)

knowledge-update-severity = &(
  info: "info",
  recommended: "recommended",
  important: "important",
  breaking: "breaking",
  critical: "critical",
)
